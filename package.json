{
  "name": "hnaya-dz-browser",
  "version": "0.5.0",
  "description": "Hnaya DZ Browser — Votre navigateur, votre réseau, vos données",
  "author": "Nacib Hamida",
  "private": true,
  "main": "public/electron.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"yarn next dev\" \"wait-on http://localhost:3000 && electron public/electron.js\"",
    "build": "next build",
    "start": "concurrently \"yarn next start\" \"electron public/electron.js\"",
    "dist": "yarn build && electron-builder --win --x64",
    "dist:mac": "yarn build && electron-builder --mac",
    "dist:linux": "yarn build && electron-builder --linux",
    "dist:all": "yarn build && electron-builder --win --x64 --mac --linux",
    "kill-dev": "taskkill /IM electron.exe /F & taskkill /IM node.exe /F"
  },
  "build": {
    "appId": "dz.hnaya.browser",
    "productName": "Hnaya DZ Browser",
    "copyright": "© 2026 Nacib Hamida",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/bin/**",
      "public/electron.js",
      "public/preload.js",
      "public/hnaya.png",
      "public/icons/**/*",
      "public/shared/**/*",
      "public/vault.js",
      "public/vault-ipc.js",
      "public/favorites.js",
      "public/favorites-ipc.js",
      "public/update-check.js"
    ],
    "extraResources": [
      {
        "from": "chat-module",
        "to": "chat-module",
        "filter": [
          "**/*",
          "!data/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hnaya DZ Browser"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/hnaya.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@heroui/button": "2.2.13",
    "@heroui/input": "2.4.13",
    "@heroui/link": "2.2.11",
    "@heroui/listbox": "2.3.13",
    "@heroui/navbar": "2.2.12",
    "@heroui/progress": "^2.2.12",
    "@heroui/switch": "2.2.12",
    "@heroui/system": "2.4.10",
    "@heroui/theme": "2.4.9",
    "@react-aria/ssr": "3.9.7",
    "@react-aria/visually-hidden": "3.8.19",
    "clsx": "2.1.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron-serve": "^2.1.1",
    "framer-motion": "11.13.1",
    "lucide-react": "^0.483.0",
    "next": "15.5.19",
    "next-themes": "^0.4.4",
    "qrcode-generator": "^2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "wait-on": "^8.0.2"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.19",
    "@react-types/shared": "3.25.0",
    "@types/node": "20.5.7",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.11.0",
    "@typescript-eslint/parser": "8.11.0",
    "autoprefixer": "10.4.19",
    "electron": "^35.0.2",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.19",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "^7.23.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "4.1.4",
    "postcss": "8.5.19",
    "prettier": "3.3.3",
    "tailwind-variants": "0.3.0",
    "tailwindcss": "3.4.16",
    "typescript": "5.6.3"
  }
}
